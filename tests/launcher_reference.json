  "scripts": {
    "run_neuroprobev2_stft_sweep.sh": {
      "inventory": {
        "DATASET_CFG": "neuroprobev2",
        "DEVICE": "cuda:3",
        "MAX_FREQUENCIES": [
          "100",
          "150",
          "250",
          "400"
        ],
        "MODELS": [
          "logistic"
        ],
        "NPERSEGS": [
          "256",
          "512",
          "1024"
        ],
        "OUTPUT_GROUP": "neuroprobev2_stft_sweep_with_val",
        "POVERLAPS": [
          "0.50",
          "0.75",
          "0.875"
        ],
        "PREPROCESSOR": "laplacian_stft_2048Hz",
        "REGIMES": [
          "within-session"
        ],
        "SUBJECT_TRIALS": [
          "1 1",
          "3 0",
          "4 0",
          "10 0",
          "7 0"
        ],
        "TASKS": "onset speech volume delta_volume pitch word_index word_gap gpt2_surprisal word_head_pos word_part_speech word_length global_flow local_flow frame_brightness face_num"
      },
      "commands": [
        [
          "-m",
          "imindbench.run_eval",
          "paths=example",
          "dataset=neuroprobev2",
          "dataset.regime=within-session",
          "dataset.label_mode=binary",
          "dataset.task=onset",
          "dataset.test_subject=1",
          "dataset.test_session=1",
          "dataset.train_same_subject_only=false",
          "dataset.train_sample_fraction=1.0",
          "model=logistic",
          "preprocessor=laplacian_stft_2048Hz",
          "preprocessor.chain.2.nperseg=256",
          "preprocessor.chain.2.poverlap=0.50",
          "preprocessor.chain.2.max_frequency=100",
          "wandb.enabled=false",
          "runtime.overwrite=false",
          "runtime.verbose=true",
          "hydra.run.dir=/runs/neuroprobev2_stft_sweep_with_val/logistic_laplacian_stft_2048Hz/nperseg256_poverlap0p50_fmax100/within-session/onset/sub1_sess1"
        ]
      ]
    },
